
module sdl;

// Types
alias DialogFileCallback = fn void(void* userdata, char** filelist, int filter);


// Structs
struct DialogFileFilter
{
	char* name;
	char* pattern;
}


// Enums
constdef FileDialogProperties : ZString
{
	FILTERS_POINTER = "SDL.filedialog.filters",
	NFILTERS_NUMBER = "SDL.filedialog.nfilters",
	WINDOW_POINTER  = "SDL.filedialog.window",
	LOCATION_STRING = "SDL.filedialog.location",
	MANY_BOOLEAN    = "SDL.filedialog.many",
	TITLE_STRING    = "SDL.filedialog.title",
	ACCEPT_STRING   = "SDL.filedialog.accept",
	CANCEL_STRING   = "SDL.filedialog.cancel",
}

enum FileDialogType
{
	OPENFILE,
	SAVEFILE,
	OPENFOLDER
}


// Functions
extern fn void show_file_dialog_with_properties(FileDialogType type, DialogFileCallback callback, void* userdata, PropertiesID props) @cname("SDL_ShowFileDialogWithProperties");
extern fn void show_open_file_dialog(DialogFileCallback callback, void* userdata, Window* window, DialogFileFilter* filters, int nfilters, char* default_location, bool allow_many) @cname("SDL_ShowOpenFileDialog");
extern fn void show_open_folder_dialog(DialogFileCallback callback, void* userdata, Window* window, char* default_location, bool allow_many) @cname("SDL_ShowOpenFolderDialog");
extern fn void show_save_file_dialog(DialogFileCallback callback, void* userdata, Window* window, DialogFileFilter* filters, int nfilters, char* default_location) @cname("SDL_ShowSaveFileDialog");
