
module sdl;

// Macros
macro bool unsupported() => set_error("That operation is not supported");
macro bool invalid_param_error(ZString param) => set_error("Parameter '%s' is invalid", param);


// Functions
extern fn bool clear_error() @cname("SDL_ClearError");
extern fn char* get_error() @cname("SDL_GetError");
extern fn bool out_of_memory() @cname("SDL_OutOfMemory");
extern fn bool set_error(char* fmt, ...) @cname("SDL_SetError");
extern fn bool set_error_v(char* fmt, CVaList ap) @cname("SDL_SetErrorV");
