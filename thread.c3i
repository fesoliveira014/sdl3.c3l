
module sdl;

// Types
typedef Thread = void;
typedef ThreadID = ulong;
typedef TlsID = AtomicInt;
alias ThreadFunction = fn int(void* data);
alias TLSDestructorCallback = fn void(void* data);


// Enums
enum ThreadPriority
{
	LOW,
	NORMAL,
	HIGH,
	TIME_CRITICAL,
}

enum ThreadState
{
	UNKNOWN,     /**< The thread is not valid */
	ALIVE,       /**< The thread is currently running */
	DETACHED,    /**< The thread is detached and can't be waited on */
	COMPLETE,    /**< The thread has finished and should be cleaned up with SDL_WaitThread() */
}

constdef ThreadCreateProperties : ZString
{
	ENTRY_FUNCTION_POINTER = "SDL.thread.create.entry_function",
	NAME_STRING            = "SDL.thread.create.name",
	USERDATA_POINTER       = "SDL.thread.create.userdata",
	STACKSIZE_NUMBER       = "SDL.thread.create.stacksize",
}


// Macros
extern fn uptr _beginthreadex(void* security, uint stack_size, void* start_address, void* arglist, uint initflag, uint* thraddr) @if(env::WIN32);
extern fn uptr _endthreadex(uint retval) @if(env::WIN32);
macro Thread* create_thread(ThreadFunction fn_, ZString name, void* data)
{
	$if (env::WIN32):
		return create_thread_runtime(fn_, name, data, (FunctionPointer)&_beginthreadex, (FunctionPointer)&_endthreadex);
	$else
		return create_thread_runtime(fn_, name, data, null, null);
	$endif
}

macro Thread* create_thread_with_properties(PropertiesID props)
{
	$if (env::WIN32):
		return create_thread_with_properties_runtime(props, (FunctionPointer)&_beginthreadex, (FunctionPointer)&_endthreadex);
	$else
		return create_thread_with_properties_runtime(props, null, null);
	$endif
}


// Functions
extern fn void cleanup_tls() @cname("SDL_CleanupTLS");
extern fn Thread* create_thread_runtime(ThreadFunction fn_, char* name, void* data, FunctionPointer pfnBeginThread, FunctionPointer pfnEndThread) @cname("SDL_CreateThreadRuntime");
extern fn Thread* create_thread_with_properties_runtime(PropertiesID props, FunctionPointer pfnBeginThread, FunctionPointer pfnEndThread) @cname("SDL_CreateThreadWithPropertiesRuntime");
extern fn void detach_thread(Thread* thread) @cname("SDL_DetachThread");
extern fn ThreadID get_current_thread_id() @cname("SDL_GetCurrentThreadID");
extern fn ThreadID get_thread_id(Thread* thread) @cname("SDL_GetThreadID");
extern fn char* get_thread_name(Thread* thread) @cname("SDL_GetThreadName");
extern fn ThreadState get_thread_state(Thread* thread) @cname("SDL_GetThreadState");
extern fn void* get_tls(TlsID* id) @cname("SDL_GetTLS");
extern fn bool set_current_thread_priority(ThreadPriority priority) @cname("SDL_SetCurrentThreadPriority");
extern fn bool set_tls(TlsID* id, void* value, TLSDestructorCallback destructor) @cname("SDL_SetTLS");
extern fn void wait_thread(Thread* thread, int* status) @cname("SDL_WaitThread");
