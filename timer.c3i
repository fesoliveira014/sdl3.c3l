
module sdl;

// Constants
const MS_PER_SECOND = 1000;
const US_PER_SECOND = 1000000;
const NS_PER_SECOND = 1000000000;
const NS_PER_MS     = 1000000;
const NS_PER_US     = 1000;


// Types
typedef TimerID = uint;
alias NSTimerCallback = fn ulong(void* userdata, TimerID timerID, ulong interval);
alias TimerCallback = fn uint(void* usedata, TimerID timerID, uint interval);


// Macros
macro seconds_to_ns(s)  => (ulong)s * NS_PER_SECOND;
macro ns_to_seconds(ns) => ns / NS_PER_SECOND;
macro ms_to_ns(ms)      => (ulong)ms * NS_PER_MS;
macro ns_to_ms(ns)      => ns / NS_PER_MS;
macro us_to_ns(us)      => (ulong)us * NS_PER_US;
macro ns_to_us(ns)      => ns / NS_PER_US;


// Functions
extern fn TimerID add_timer(uint interval, TimerCallback callback, void* userdata) @cname("SDL_AddTimer");
extern fn TimerID add_timer_ns(ulong interval, NSTimerCallback callback, void* userdata) @cname("SDL_AddTimerNS");
extern fn void delay(uint ms) @cname("SDL_Delay");
extern fn void delay_ns(ulong ns) @cname("SDL_DelayNS");
extern fn void delay_precise(ulong ns) @cname("SDL_DelayPrecise");
extern fn ulong get_performance_counter() @cname("SDL_GetPerformanceCounter");
extern fn ulong get_performance_frequency() @cname("SDL_GetPerformanceFrequency");
extern fn ulong get_ticks() @cname("SDL_GetTicks");
extern fn ulong get_ticks_ns() @cname("SDL_GetTicksNS");
extern fn bool remove_timer(TimerID id) @cname("SDL_RemoveTimer");
