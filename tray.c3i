
module sdl;

// Types
typedef Tray = void;
typedef TrayEntry = void;
typedef TrayMenu = void;
alias TrayCallback = fn void(void* userdata, TrayEntry* entry);
alias TrayClickCallback = fn bool(void* userdata, Tray* tray);


// Bitstructs
bitstruct TrayEntryFlags : uint
{
	bool button   : 0;
	bool checkbox : 1;
	bool submenu  : 2;
	bool checked  : 30;
	bool disabled : 31;
}


// Functions
extern fn void click_tray_entry(TrayEntry* entry) @cname("SDL_ClickTrayEntry");
extern fn Tray* create_tray(Surface* icon, char* tooltip) @cname("SDL_CreateTray");
extern fn TrayMenu* create_tray_menu(Tray* tray) @cname("SDL_CreateTrayMenu");
extern fn TrayMenu* create_tray_submenu(TrayEntry* entry) @cname("SDL_CreateTraySubmenu");
extern fn Tray* create_tray_with_properties(PropertiesID props) @cname("SDL_CreateTrayWithProperties");
extern fn void destroy_tray(Tray* tray) @cname("SDL_DestroyTray");
extern fn TrayEntry** get_tray_entries(TrayMenu* menu, int* count) @cname("SDL_GetTrayEntries");
extern fn bool get_tray_entry_checked(TrayEntry* entry) @cname("SDL_GetTrayEntryChecked");
extern fn bool get_tray_entry_enabled(TrayEntry* entry) @cname("SDL_GetTrayEntryEnabled");
extern fn char* get_tray_entry_label(TrayEntry* entry) @cname("SDL_GetTrayEntryLabel");
extern fn TrayMenu* get_tray_entry_parent(TrayEntry* entry) @cname("SDL_GetTrayEntryParent");
extern fn TrayMenu* get_tray_menu(Tray* tray) @cname("SDL_GetTrayMenu");
extern fn TrayEntry* get_tray_menu_parent_entry(TrayMenu* menu) @cname("SDL_GetTrayMenuParentEntry");
extern fn Tray* get_tray_menu_parent_tray(TrayMenu* menu) @cname("SDL_GetTrayMenuParentTray");
extern fn TrayMenu* get_tray_submenu(TrayEntry* entry) @cname("SDL_GetTraySubmenu");
extern fn TrayEntry* insert_tray_entry_at(TrayMenu* menu, int pos, char* label, TrayEntryFlags flags) @cname("SDL_InsertTrayEntryAt");
extern fn void remove_tray_entry(TrayEntry* entry) @cname("SDL_RemoveTrayEntry");
extern fn void set_tray_entry_callback(TrayEntry* entry, TrayCallback callback, void *userdata) @cname("SDL_SetTrayEntryCallback");
extern fn void set_tray_entry_checked(TrayEntry* entry, bool checked) @cname("SDL_SetTrayEntryChecked");
extern fn void set_tray_entry_enabled(TrayEntry* entry, bool enabled) @cname("SDL_SetTrayEntryEnabled");
extern fn void set_tray_entry_label(TrayEntry* entry, char* label) @cname("SDL_SetTrayEntryLabel");
extern fn void set_tray_icon(Tray* tray, Surface* icon) @cname("SDL_SetTrayIcon");
extern fn void set_tray_tooltip(Tray* tray, char* tooltip) @cname("SDL_SetTrayTooltip");
extern fn void update_trays() @cname("SDL_UpdateTrays");
