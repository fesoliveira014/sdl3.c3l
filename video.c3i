module sdl::gl;

import sdl::stdinc;

// Types
typedef Profile = uint;
const Profile CONTEXT_PROFILE_CORE          = (Profile)0x0001;
const Profile CONTEXT_PROFILE_COMPATIBILITY = (Profile)0x0002;
const Profile CONTEXT_PROFILE_ES            = (Profile)0x0004;


// Functions
extern fn GLContext create_context(Window* window) @cname("SDL_GL_CreateContext");
extern fn bool destroy_context(GLContext context) @cname("SDL_GL_DestroyContext");
extern fn bool extension_supported(char* extension) @cname("SDL_GL_ExtensionSupported");
extern fn bool get_attribute(GLAttr attr, int* value) @cname("SDL_GL_GetAttribute");
extern fn GLContext get_current_context() @cname("SDL_GL_GetCurrentContext");
extern fn Window* get_current_window() @cname("SDL_GL_GetCurrentWindow");
extern fn FunctionPointer get_proc_address(char* proc) @cname("SDL_GL_GetProcAddress");
extern fn bool get_swap_interval(int* interval) @cname("SDL_GL_GetSwapInterval");
extern fn bool load_library(char* path) @cname("SDL_GL_LoadLibrary");
extern fn bool make_current(Window* window, GLContext context) @cname("SDL_GL_MakeCurrent");
extern fn void reset_attributes() @cname("SDL_GL_ResetAttributes");
extern fn bool set_attribute(GLAttr attr, int value) @cname("SDL_GL_SetAttribute");
extern fn bool set_swap_interval(int interval) @cname("SDL_GL_SetSwapInterval");
extern fn bool swap_window(Window* window) @cname("SDL_GL_SwapWindow");
extern fn void unload_library() @cname("SDL_GL_UnloadLibrary");


module sdl::egl;

import sdl::stdinc;

extern fn EGLConfig get_current_config() @cname("SDL_EGL_GetCurrentConfig");
extern fn EGLDisplay get_current_display() @cname("SDL_EGL_GetCurrentDisplay");
extern fn FunctionPointer get_proc_address(char* proc) @cname("SDL_EGL_GetProcAddress");
extern fn Surface get_window_surface(Window* window) @cname("SDL_EGL_GetWindowSurface");
extern fn void set_attribute_callbacks(EGLAttribArrayCallback platformAttribCallback, EGLIntArrayCallback surfaceAttribCallback, EGLIntArrayCallback contextAttribCallback, void* userdata) @cname("SDL_EGL_SetAttributeCallbacks");
