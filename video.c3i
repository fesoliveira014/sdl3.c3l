// Macros
macro windowpos_undefined_display(x) => WINDOWPOS_UNDEFINED_MASK | (uint)x;
macro windowpos_undefined()          => windowpos_undefined_display(0);
macro windowpos_isundefined(x)       => ((uint)x & 0xFFFF0000) == WINDOWPOS_UNDEFINED_MASK;
macro windowpos_centered_display(x)  => WINDOWPOS_CENTERED_MASK | (uint)x;
macro windowpos_centered()           => windowpos_centered_display(0);
macro windowpos_iscentered(x)        => ((uint)x & 0xFFFF0000) == WINDOWPOS_CENTERED_MASK;


